{
  "name": "aca_phase1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/browser-harness.cjs",
    "test:rules": "node --test tests/firestore-rules.cjs",
    "test:firebase": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-aca \"npm run test:rules\"",
    "test:e2e:auth": "npx -y firebase-tools@latest emulators:exec --only auth,firestore --project demo-aca \"node tests/auth-browser.cjs\"",
    "test:pdf-package": "node tests/pdf-packaging.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource/instrument-serif": "5.2.8",
    "@gsap/react": "2.1.2",
    "firebase": "^13.0.0",
    "firebase-admin": "13.10.0",
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdf2json": "^4.0.3",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1"
  }
}
